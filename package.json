    "@tiptap/starter-kit": "^3.31.3",
    "@vinejs/vine": "^4.3.1",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "edge.js": "^6.2.1",
    "lucide-react": "^1.46.0",
