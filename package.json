{
  "name": "doc-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.inertia.json"
  },
  "imports": {
